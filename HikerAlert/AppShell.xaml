<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HikerAlert.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HikerAlert"
    Shell.FlyoutBehavior="Disabled"
    Title="HikerAlert">

    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate local:LoginPage}" />

    <TabBar Shell.TabBarBackgroundColor="White"
            Shell.TabBarForegroundColor="#247A52"
            Shell.TabBarUnselectedColor="#77837C">

        <ShellContent
            Title="Home"
            Route="MainPage"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="Trails"
            Route="HikingTrailsPage"
            ContentTemplate="{DataTemplate local:HikingTrailsPage}" />

        <ShellContent
            Title="Tools"
            Route="ToolsPage"
            ContentTemplate="{DataTemplate local:ToolsPage}" />

        <ShellContent
            Title="Settings"
            Route="Settings"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            />
    </TabBar>
</Shell>
